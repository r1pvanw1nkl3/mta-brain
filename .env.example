# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=mta_brain
DB_PASSWORD=postgres_password

# ETL Database User (defaults to postgres for minimalism)
ETL_DB_USER=postgres
ETL_DB_PASSWORD=postgres_password

# Application Database User (restricted read-only access)
APP_DB_USER=app_user
APP_DB_PASSWORD=app_password

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# OSRM Configuration
# Use http://localhost:5005 when running locally outside of Docker
# Use http://osrm:5000 when running inside the Docker network
OSRM_URL=http://localhost:5005
